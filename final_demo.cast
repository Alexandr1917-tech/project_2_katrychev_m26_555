[0.018011, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                         \r \r"]
[0.018402, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[Jaleksandr@MacBook-Air-Aleksandr project_2_katrychev_m26_555 % \u001b[K\u001b[?2004h"]
[4.411515, "o", "\u001b[7mdatabase\u001b[27m"]
[5.025051, "o", "\u001b[8D\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me"]
[5.025295, "o", "\u001b[?2004l\r\r\n"]
[5.076644, "o", "***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... — создать таблицу\r\n<command> list_tables — показать список всех таблиц\r\n<command> drop_table <имя_таблицы> — удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) — создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> — прочитать записи\r\n<command> select from <имя_таблицы> — прочитать все записи\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец> = <значение> — обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> — удалить запись\r\n<command> info <имя_табл"]
[5.07668, "o", "ицы> — вывести информацию о таблице\r\n<command> exit — выход из программы\r\n<command> help — справочная информация\r\n\r\n"]
[5.076884, "o", ">>>Введите команду: "]
[10.166186, "o", "create_table users name:str age:int is_active:bool"]
[10.802915, "o", "\r\n"]
[10.804476, "o", ">>>Введите команду: "]
[16.277423, "o", "insert into users values (\"Sergei\", 28, true)"]
[16.919328, "o", "\r\n"]
[16.921023, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[16.921246, "o", ">>>Введите команду: "]
[22.145356, "o", "insert into users values (\"Anna\", 30, false)"]
[22.754099, "o", "\r\n"]
[22.755507, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[22.755645, "o", ">>>Введите команду: "]
[28.010903, "o", "select from users"]
[28.565997, "o", "\r\n"]
[28.607064, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  30 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[28.60719, "o", ">>>Введите команду: "]
[36.89167, "o", "update users set age = 29 where name = \"Sergei\""]
[37.498106, "o", "\r\n"]
[37.499076, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[37.499203, "o", ">>>Введите команду: "]
[42.59874, "o", "select from users"]
[43.211719, "o", "\r\n"]
[43.212841, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n| 2  |  Anna  |  30 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[43.213013, "o", ">>>Введите команду: "]
[49.683934, "o", "delete from users where ID = 1"]
[50.370182, "o", "\r\n"]
[50.371532, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[50.371692, "o", ">>>Введите команду: "]
[55.414485, "o", "select from users"]
[55.989584, "o", "\r\n"]
[55.990315, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  30 |   False   |\r\n+----+------+-----+-----------+\r\n"]
[55.990545, "o", ">>>Введите команду: "]
[61.309942, "o", "info users"]
[62.22711, "o", "\r\n"]
[62.227672, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[62.227924, "o", ">>>Введите команду: "]
[63.967461, "o", "e"]
[64.322963, "o", "x"]
[64.732497, "o", "i"]
[65.023567, "o", "t"]
[66.762023, "o", "\r\n"]
[66.762287, "o", "Выход из программы.\r\n"]
[66.776242, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                         \r \r"]
