[33.857277, "o", "\u001b[?2004l\r\r\n"]
[33.927238, "o", "***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... — создать таблицу\r\n<command> list_tables — показать список всех таблиц\r\n<command> drop_table <имя_таблицы> — удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) — создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> — прочитать записи\r\n<command> select from <имя_таблицы> — прочитать все записи\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец> = <значение> — обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> — удалить запись\r\n<command> info <имя_табл"]
[33.927275, "o", "ицы> — вывести информацию о таблице\r\n<command> exit — выход из программы\r\n<command> help — справочная информация\r\n\r\n"]
[33.92737, "o", ">>>Введите команду: "]
[39.654783, "o", "select from users"]
[40.188298, "o", "\r\n"]
[40.189787, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[40.217058, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[40.21712, "o", ">>>Введите команду: "]
[45.532838, "o", "delete from users where ID = 1"]
[46.171481, "o", "\r\n"]
[46.17224, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[47.460202, "o", "n"]
[48.568337, "o", "\r\n"]
[48.568537, "o", "Операция отменена.\r\n"]
[48.568874, "o", ">>>Введите команду: "]
[50.45563, "o", "delete from users where ID = 1"]
[51.490848, "o", "\r\n"]
[51.491149, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[52.943688, "o", "y"]
[53.772492, "o", "\r\n"]
[53.773139, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[53.77329, "o", ">>>Введите команду: "]
[59.345106, "o", "drop_table users"]
[59.984474, "o", "\r\n"]
[59.984849, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[61.342728, "o", "n"]
[62.366361, "o", "\r\n"]
[62.366558, "o", "Операция отменена.\r\n"]
[62.366672, "o", ">>>Введите команду: "]
[65.296532, "o", "drop_table users"]
[65.926914, "o", "\r\n"]
[65.927183, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[67.561337, "o", "y"]
[68.701952, "o", "\r\n"]
[68.702655, "o", "Таблица \"users\" успешно удалена.\r\n"]
[68.703854, "o", ">>>Введите команду: "]
[74.429414, "o", "exit"]
