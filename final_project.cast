[0.02528, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[Jaleksandr@MacBook-Air-Aleksandr project_2_katrychev_m26_555 % \u001b[K\u001b[?2004h"]
[0.942388, "o", "\u001b[7mdatabase\u001b[27m"]
[1.994587, "o", "\u001b[8D\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me\u001b[?2004l\r\r\n"]
[2.02307, "o", "***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... — создать таблицу\r\n<command> list_tables — показать список всех таблиц\r\n<command> drop_table <имя_таблицы> — удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) — создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> — прочитать записи\r\n<command> select from <имя_таблицы> — прочитать все записи\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец> = <значение> — обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> — удалить запись\r\n<command> info <имя_табл"]
[2.023099, "o", "ицы> — вывести информацию о таблице\r\n<command> exit — выход из программы\r\n<command> help — справочная информация\r\n\r\n"]
[2.023404, "o", ">>>Введите команду: "]
[7.881917, "o", "create_table users name:str age:int is_active:bool"]
[8.454683, "o", "\r\n"]
[8.457318, "o", ">>>Введите команду: "]
[13.477995, "o", "insert into users values (\"Sergei\", 28, true)"]
[14.05406, "o", "\r\n"]
[14.054627, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[14.056801, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[14.057126, "o", ">>>Введите команду: "]
[19.922663, "o", "select from users"]
[20.483564, "o", "\r\n"]
[20.484036, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[20.517491, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[20.517604, "o", ">>>Введите команду: "]
[25.847879, "o", "update users set age = 29 where name = \"Sergei\""]
[26.468398, "o", "\r\n"]
[26.469825, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[26.470019, "o", ">>>Введите команду: "]
[31.330576, "o", "exit"]
[32.011079, "o", "\r\n"]
[32.011388, "o", "Выход из программы.\r\n"]
[32.024998, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                                        \r \r"]
