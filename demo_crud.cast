[0.018891, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                         \r \r"]
[0.019369, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[Jaleksandr@MacBook-Air-Aleksandr project_2_katrychev_m26_555 % \u001b[K\u001b[?2004h"]
[5.114092, "o", "\u001b[7muv run python -m primitive_db.main\u001b[27m"]
[5.796345, "o", "\u001b[34D\u001b[27mu\u001b[27mv\u001b[27m \u001b[27mr\u001b[27mu\u001b[27mn\u001b[27m \u001b[27mp\u001b[27my\u001b[27mt\u001b[27mh\u001b[27mo\u001b[27mn\u001b[27m \u001b[27m-\u001b[27mm\u001b[27m \u001b[27mp\u001b[27mr\u001b[27mi\u001b[27mm\u001b[27mi\u001b[27mt\u001b[27mi\u001b[27mv\u001b[27me\u001b[27m_\u001b[27md\u001b[27mb\u001b[27m.\u001b[27mm\u001b[27ma\u001b[27mi\u001b[27mn\u001b[?2004l\r\r\n"]
[5.91881, "o", "***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... — создать таблицу\r\n<command> list_tables — показать список всех таблиц\r\n<command> drop_table <имя_таблицы> — удалить таблицу\r\n<command> exit — выход из программы\r\n<command> help — справочная информация\r\n\r\n"]
[5.918985, "o", ">>>Введите команду: "]
[10.995695, "o", "create_table users name:str age:int is_active:bool"]
[11.684404, "o", "\r\n"]
[11.68592, "o", ">>>Введите команду: "]
[17.352639, "o", "insert into users values (\"Sergei\", 28, true)"]
[17.992007, "o", "\r\n"]
[17.993365, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[17.993696, "o", ">>>Введите команду: "]
[23.433846, "o", "insert into users values (\"Anna\", 30, false)"]
[24.047695, "o", "\r\n"]
[24.04915, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[24.0493, "o", ">>>Введите команду: "]
[29.674781, "o", "select from users"]
[30.313223, "o", "\r\n"]
[30.34468, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  30 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[30.3448, "o", ">>>Введите команду: "]
[36.824673, "o", "update users set age = 29 where name = \"Sergei\""]
[37.492417, "o", "\r\n"]
[37.49338, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[37.493544, "o", ">>>Введите команду: "]
[43.262869, "o", "select from users"]
[43.891117, "o", "\r\n"]
[43.89199, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n| 2  |  Anna  |  30 |   False   |\r\n+----+--------+-----+-----------+\r\n"]
[43.892137, "o", ">>>Введите команду: "]
[50.517413, "o", "delete from users where ID = 1"]
[51.106468, "o", "\r\n"]
[51.107401, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[51.107516, "o", ">>>Введите команду: "]
[56.139236, "o", "select from users"]
[56.719771, "o", "\r\n"]
[56.720953, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  30 |   False   |\r\n+----+------+-----+-----------+\r\n"]
[56.721165, "o", ">>>Введите команду: "]
[62.225804, "o", "info users"]
[64.060143, "o", "\r\n"]
[64.060673, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[64.060827, "o", ">>>Введите команду: "]
[65.901586, "o", "e"]
[66.132542, "o", "x"]
[66.733124, "o", "i"]
[67.128393, "o", "t"]
[67.943527, "o", "\r\n"]
[67.943822, "o", "Выход из программы.\r\n"]
[67.958162, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                         \r \r"]
