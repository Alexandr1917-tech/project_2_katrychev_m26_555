[14.146893, "o", "***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... — создать таблицу\r\n<command> list_tables — показать список всех таблиц\r\n<command> drop_table <имя_таблицы> — удалить таблицу\r\n<command> exit — выход из программы\r\n<command> help — справочная информация\r\n\r\n"]
[14.146929, "o", ">>>Введите команду: "]
[20.707683, "o", "create_table users name:str age:int"]
[21.622708, "o", "\r\n"]
[21.624611, "o", ">>>Введите команду: "]
[27.918779, "o", "list_tables"]
[28.760508, "o", "\r\n"]
[28.760778, "o", "- users\r\n"]
[28.761236, "o", ">>>Введите команду: "]
[36.465647, "o", "drop_table users"]
[37.498838, "o", "\r\n"]
[37.499535, "o", ">>>Введите команду: "]
[43.777462, "o", "exit"]
[44.302969, "o", "\r\n"]
[44.303237, "o", "Выход из программы.\r\n"]
