[4.500556, "o", "\u001b[7mdatabase\u001b[27m"]
[5.069841, "o", "\u001b[8D\u001b[27md\u001b[27ma\u001b[27mt\u001b[27ma\u001b[27mb\u001b[27ma\u001b[27ms\u001b[27me\u001b[?2004l"]
[5.0699, "o", "\r\r\n"]
[5.120208, "o", "***База данных***\r\n\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> <столбец2:тип> ... — создать таблицу\r\n<command> list_tables — показать список всех таблиц\r\n<command> drop_table <имя_таблицы> — удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) — создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> — прочитать записи\r\n<command> select from <имя_таблицы> — прочитать все записи\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец> = <значение> — обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> — удалить запись\r\n<command> info <имя_табл"]
[5.120239, "o", "ицы> — вывести информацию о таблице\r\n<command> exit — выход из программы\r\n<command> help — справочная информация\r\n\r\n"]
[5.120421, "o", ">>>Введите команду: "]
[9.829402, "o", "create_table users name:str age:int"]
[10.364879, "o", "\r\n"]
[10.366453, "o", ">>>Введите команду: "]
[15.216236, "o", "insert into users values (\"Sergei\", 28)"]
[15.721265, "o", "\r\n"]
[15.721564, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[15.723045, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[15.723201, "o", ">>>Введите команду: "]
[20.412899, "o", "select from users"]
[20.94165, "o", "\r\n"]
[20.942254, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[20.979616, "o", "+----+--------+-----+\r\n| ID |  name  | age |\r\n+----+--------+-----+\r\n| 1  | Sergei |  28 |\r\n+----+--------+-----+\r\n"]
[20.979735, "o", ">>>Введите команду: "]
[26.68267, "o", "drop_table users"]
[27.429969, "o", "\r\n"]
[27.430238, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[28.931849, "o", "n"]
[30.055003, "o", "\r\n"]
[30.055285, "o", "Операция отменена.\r\n"]
[30.055554, "o", ">>>Введите команду: "]
[32.285828, "o", "drop_table users"]
[33.698184, "o", "\r\n"]
[33.698433, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[34.986622, "o", "y"]
[35.731215, "o", "\r\n"]
[35.731824, "o", "Таблица \"users\" успешно удалена.\r\n"]
[35.732952, "o", ">>>Введите команду: "]
[41.31616, "o", "create_table users name:str"]
[41.898966, "o", "\r\n"]
[41.900536, "o", ">>>Введите команду: "]
[46.6883, "o", "insert into users values (\"Sergei\")"]
[47.457375, "o", "\r\n"]
[47.458054, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[47.458952, "o", "Запись успешно добавлена в таблицу \"users\".\r\n"]
[47.459209, "o", ">>>Введите команду: "]
